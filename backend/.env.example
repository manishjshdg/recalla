# ============================================================
# Incident Response Agent — Environment Configuration
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./incident_response.db

# --- Hindsight Memory ---
# Option 1: Self-hosted Hindsight server
HINDSIGHT_BASE_URL=http://localhost:8888
# Option 2: Hindsight Cloud (uncomment and set your API key)
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_API_KEY=your-hindsight-cloud-api-key

HINDSIGHT_BANK_ID=incident-response-agent

# --- LLM Provider ---
# Supported: openai, anthropic, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (optional alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini (optional alternative)  
# GEMINI_API_KEY=your-gemini-api-key-here

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
ANALYZE_RATE_LIMIT_PER_MINUTE=10
